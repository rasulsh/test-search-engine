{
    "name": "rasulsh/test-search-engine",
    "description": "Two-tier product search service for OpenCart (keyword + semantic). Server has zero runtime Composer dependencies; Composer is dev-only.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "squizlabs/php_codesniffer": "^3.11"
    },
    "autoload": {
        "psr-4": {
            "App\\": "server/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "server/tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.3.0"
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "lint": "phpcs"
    }
}
