# /etc/search-vectors.env — read by the systemd unit. setup.sh writes it once
# (with a random VPS_TOKEN) and never overwrites it. Keep it 0640 root:searchvec.

# Shared secret; cPanel sends "Authorization: Bearer <token>". At least 16 chars.
VPS_TOKEN=

# Bind address. Keep 127.0.0.1 behind a TLS reverse proxy, or bind the public
# IP with VPS_SSL_* set and the firewall open to the cPanel server's IP only.
VPS_HOST=127.0.0.1
VPS_PORT=8600
VPS_SSL_CERTFILE=
VPS_SSL_KEYFILE=

# Query model. MUST match pipeline/config.py vps_model (contract 2); /reload
# refuses vectors whose meta.json disagrees.
VPS_MODEL=BAAI/bge-m3
VPS_MODEL_REVISION=5617a9f61b028005a4858fdac845db406aefb181
VPS_MODEL_DIM=1024
VPS_POOLING=cls
VPS_QUERY_PREFIX=
VPS_EMBEDDER=onnx
VPS_MODEL_DIR=/opt/search-vectors/model
# int8 (fits 2 GB) or onnx/model.onnx (fp32, exact parity, ~2.5 GB RAM).
VPS_ONNX_FILE=onnx/model_quantized.onnx
VPS_MAX_TOKENS=512
VPS_THREADS=0

# active/ (served), incoming/ (upload here, then POST /reload), previous/ (rollback).
VPS_DATA_DIR=/var/lib/search-vectors

# Cosine floor: neighbours below it are not returned. Tune on the eval set.
VPS_SEMANTIC_MIN_SCORE=0.5
VPS_DEFAULT_LIMIT=100
VPS_MAX_LIMIT=500
VPS_MAX_QUERY_CHARS=200
