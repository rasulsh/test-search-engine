# Example environment for the search service.
# Copy to `.env` (gitignored) and adjust. Never commit real secrets.
# The server reads all model names, dimensions, and thresholds from config —
# nothing here is hardcoded elsewhere.

# --- Database (PDO DSN + credentials) ---
SEARCH_DB_DSN=mysql:host=localhost;dbname=search;charset=utf8mb4
SEARCH_DB_USER=search
SEARCH_DB_PASSWORD=
SEARCH_PRODUCTS_TABLE=products
SEARCH_SEARCH_LOGS_TABLE=search_logs

# --- Bundle model (stamped into meta.json by the pipeline; checked on /reload) ---
# /search no longer reads the bundle's vectors (M18): the semantic tier runs on
# the VPS. Never hardcode these.
SEARCH_MODEL=intfloat/multilingual-e5-small
SEARCH_MODEL_REVISION=main
SEARCH_MODEL_DIM=384
# Defaults to the deployed code's Normalizer::VERSION (the pipeline stamps its
# own into meta.json), so rules bumps need no edit. Set only to pin a version.
# SEARCH_NORMALIZATION_VERSION=

# --- VPS vector service model (pipeline/build.py --vps-out; vps/README.md) ---
# MUST match the VPS's VPS_MODEL* / VPS_POOLING / VPS_QUERY_PREFIX (contract 2).
SEARCH_VPS_MODEL=BAAI/bge-m3
SEARCH_VPS_MODEL_REVISION=5617a9f61b028005a4858fdac845db406aefb181
SEARCH_VPS_MODEL_DIM=1024
SEARCH_VPS_POOLING=cls
# bge-m3 dense retrieval takes no instruction on either side.
SEARCH_VPS_QUERY_PREFIX=
SEARCH_VPS_PASSAGE_PREFIX=

# --- VPS vector service, called by cPanel's /search (M18; vps/README.md) ---
# Base URL (the client appends /search-vectors); empty = keyword-only search.
SEARCH_VPS_URL=
# The VPS's VPS_TOKEN (secret: set it here or in config.php, never commit it).
SEARCH_VPS_TOKEN=
# Whole-call budget (connect + response). A slower or unreachable VPS means
# keyword-only results for that request, never an error.
SEARCH_VPS_TIMEOUT_MS=300

# --- Search behaviour ---
SEARCH_DEFAULT_LIMIT=20
# Mirror the host's innodb_ft_min_token_size (default 3); shorter tokens use the
# LIKE fallback.
SEARCH_MIN_TOKEN_SIZE=3
# Keyword field weighting: title hits dominate description hits; phrase bonus
# when the query words sit together in the title. Any title match ranks above
# any description-only match; the weights order within those bands.
SEARCH_TITLE_WEIGHT=10.0
SEARCH_DESC_WEIGHT=1.0
SEARCH_PHRASE_BONUS=5.0
# Spec matches (attributes, feature titles) rank between title and
# description-only matches; this weights a token found only in the specs.
SEARCH_SPEC_WEIGHT=6.0
# Tags (oc_tag names: franchise / alternate product names), brand and category
# are searched fields too (M21), ranked tags > brand > category > specs. Tags sit
# just below the title weight.
SEARCH_TAG_WEIGHT=8.0
SEARCH_BRAND_WEIGHT=7.0
SEARCH_CATEGORY_WEIGHT=5.0
# SKU search: exact normalized-SKU matches rank first, then prefix matches
# (queries of at least this many characters that contain a digit).
SEARCH_SKU_PREFIX_MIN_LENGTH=4
# Synonym / alias expansion: query variants tried, the literal one included
# (1 disables); generated synonym groups larger than the cap are ignored.
SEARCH_ALIAS_MAX_VARIANTS=6
SEARCH_SYNONYMS_MAX_GROUP_SIZE=4
# Multi-word queries match only products holding every word (title, specs and
# description combined); with none, the products matching the most words are
# served. While there are all-words hits, semantic neighbours are not appended.
# 0 always serves partial matches (most words first).
SEARCH_REQUIRE_ALL_TERMS=1
# Soft AND (M23): below SOFT_AND_MIN_RESULTS full-coverage hits a multi-word query
# is topped up with partial matches (>= MIN_COVERAGE of the words), ranked below
# every full-coverage hit; PENALTY scales their keyword score in the hybrid blend;
# CANDIDATE_CAP bounds the rows scored per alias variant. 0 min results = strict.
SEARCH_SOFT_AND_MIN_RESULTS=3
SEARCH_SOFT_AND_MIN_COVERAGE=0.5
SEARCH_SOFT_AND_PARTIAL_PENALTY=0.5
SEARCH_SOFT_AND_CANDIDATE_CAP=100
# Collapsed names (M23): "farcry" = "far cry". Weight of that match (below the
# title weight; 0 = off) and the shortest collapsed query tried. Needs the M23
# rebuild + reload (column normalized_collapsed).
SEARCH_COLLAPSE_WEIGHT=9.0
SEARCH_COLLAPSE_MIN_LENGTH=5
# Tier 2 (semantic) — VPS cosine top-K width, then the blended hybrid ranking.
SEARCH_SEMANTIC_TOP_K=300
# Cosine floor (bge-m3 scale; e5's old 0.82 is far too high): neighbours below
# it are dropped. A starting point that NEEDS tuning on the real catalog; the
# keyword tier blended with it carries one-word precision.
SEARCH_SEMANTIC_MIN_SCORE=0.4
# Blended ranking (M20): relevance = KEYWORD_WEIGHT * keyword_norm +
# SEMANTIC_WEIGHT * semantic_norm (each scaled to 0..1 within the result set);
# weak keyword hits (specs / description only) and
# semantic-only neighbours below MIN_RELEVANCE are dropped; title and SKU hits never are. Starting points: tune on real queries.
SEARCH_KEYWORD_WEIGHT=0.4
SEARCH_SEMANTIC_WEIGHT=0.6
SEARCH_MIN_RELEVANCE=0.45
# Light business boosts applied AFTER blending (kept small on purpose).
SEARCH_STOCK_BOOST=0.1
SEARCH_POPULARITY_BOOST=0.1
# Match boosts (M21), same kind, applied after the floor: all words of the
# product's brand / category name are in the query (or an alias variant), or a
# query of >= TAG_MATCH_MIN_TOKENS words is a phrase inside the product's tags.
# 0 disables one. Hybrid mode only.
SEARCH_BRAND_MATCH_BOOST=0.15
SEARCH_CATEGORY_MATCH_BOOST=0.1
SEARCH_TAG_MATCH_BOOST=0.1
SEARCH_TAG_MATCH_MIN_TOKENS=2
SEARCH_LATENCY_BUDGET_MS=200
# "Did you mean": only below this many keyword hits, only candidates seen in at
# least MIN_FREQUENCY products, at most MAX_DISTANCE edits.
SEARCH_SUGGEST_MIN_RESULTS=3
SEARCH_SUGGEST_MIN_FREQUENCY=2
SEARCH_SUGGEST_MAX_DISTANCE=2

# --- Read-only tooling (M21; each is off while its token is empty) ---
# /search with "debug": 1 and this token in X-Debug-Token returns a score breakdown.
SEARCH_DEBUG_TOKEN=
# public/logs.php: recent searches, zero-result and slowest views. Token in the
# X-Logs-Token header or ?token=. Use long random, different secrets.
SEARCH_LOGS_TOKEN=
SEARCH_LOGS_PAGE_SIZE=50

# --- Storefront bases for with_details product links / images (empty = as exported) ---
SEARCH_STORE_BASE=
SEARCH_IMAGE_BASE=

# --- Build machine only (pipeline/config.py; release.py --desc-index-chars overrides):
# leading description characters keyword-indexed. The server never reads it. ---
SEARCH_DESC_INDEX_CHARS=800

# --- Bundle paths (active + staging for atomic reload) ---
SEARCH_DATA_DIR=./server/data
SEARCH_DATA_INCOMING_DIR=./server/data_incoming

# --- Token protecting POST /reload (set a strong random value in production) ---
SEARCH_RELOAD_TOKEN=

# --- Offline build machine (pipeline/db_export.py reads this file; never commit .env) ---
OC_DB_HOST=127.0.0.1
OC_DB_PORT=3306
OC_DB_USER=
OC_DB_PASSWORD=
OC_DB_NAME=
# OC_DB_PREFIX=oc_
# OC_LANGUAGE_ID=2

# --- Embedding on the build machine (pipeline/embed.py; docs/PIPELINE.md, docs/TRAINING-COLAB.md) ---
# auto = cuda when torch sees a GPU, else cpu; or cpu / cuda / cuda:N.
SEARCH_EMBED_DEVICE=auto
# auto = fp16 on CUDA only; on / off force it.
SEARCH_EMBED_FP16=auto
SEARCH_EMBED_BATCH_SIZE=16
# release.py: the cPanel bundle's vectors.bin is unread by /search since M18, so it is
# built with the mock embedder. "real" builds real e5 vectors (slower, no benefit).
SEARCH_BUNDLE_EMBEDDER=mock

# --- Offline alias generator (pipeline/gen_aliases.py; docs/ALIASES.md) ---
# Any OpenAI-compatible chat endpoint. Prep time only, never at search time.
ALIAS_LLM_BASE_URL=
ALIAS_LLM_MODEL=
ALIAS_LLM_API_KEY=
# ALIAS_LLM_BATCH_SIZE=40
# ALIAS_MAX_VARIANTS=4
# ALIAS_MAX_VARIANT_CHARS=40
# ALIAS_MAX_NAME_CHARS=60
