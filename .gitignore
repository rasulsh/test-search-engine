# PHP / Composer (runtime has zero Composer deps; Composer is dev-only)
/vendor/
composer.lock
.phpunit.cache/
.phpunit.result.cache
.php-cs-fixer.cache
.phpcs.cache

# Node / client model assets
node_modules/
/client/model/
# Self-hosted browser runtime + font (pipeline/tools/fetch_web_model.py)
/client/vendor/
/client/fonts/
/server/public/client
# Offline-only client deps (installed ad hoc for the model-parity check)
/client/package.json
/client/package-lock.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/

# Server runtime data: active bundle + staging + rollback backup (never committed)
/server/data/
/server/data_incoming/
/server/data_old/

# Index bundles produced offline
/bundle/
/vps_vectors/
*.bin
*.idx

# Local configuration and secrets
/server/config.php
.env
*.local.php

# Editor / OS
.DS_Store
*.swp
